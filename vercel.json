{
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/home-2",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/about-3",
      "destination": "/about",
      "permanent": true
    },
    {
      "source": "/services-2",
      "destination": "/services",
      "permanent": true
    },
    {
      "source": "/contact-2",
      "destination": "/contact",
      "permanent": true
    },
    {
      "source": "/book-a-visit-now",
      "destination": "/book",
      "permanent": true
    },
    {
      "source": "/our-staff",
      "destination": "/about",
      "permanent": true
    },
    {
      "source": "/thanks",
      "destination": "/thank-you",
      "permanent": true
    },
    {
      "source": "/welcome",
      "destination": "/contact",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=31536000; includeSubDomains"
        },
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, noarchive"
        }
      ]
    }
  ]
}
