# Underchargers v8.12 production migration rules
# Rename to .htaccess ONLY at HostGator production cutover after backup.
Options -Indexes
ErrorDocument 404 /404.html

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
</IfModule>

# Legitimate legacy URLs: preserve ranking signals with one-hop permanent redirects
RedirectMatch 301 ^/home\-2/?$ https://underchargers.com/
RedirectMatch 301 ^/about\-3/?$ https://underchargers.com/about/
